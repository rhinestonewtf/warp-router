    function testFuzzHashEquivalence_TokenIn(uint256[2][] calldata tokenIn) public {
        vm.assume(tokenIn.length > 0 && tokenIn.length <= 10);

        // Ensure valid addresses in the packed format
        for (uint256 i = 0; i < tokenIn.length; i++) {
            vm.assume(uint160(tokenIn[i][0]) != 0);
            vm.assume(tokenIn[i][1] > 0);
        }

        bytes32 originalHash = original.hashTokenIn(tokenIn);
        bytes32 optimizedHash = optimized.hashTokenIn(tokenIn);

        assertEq(originalHash, optimizedHash, "Fuzz: TokenIn hash mismatch");
    }

    function testFuzzHashEquivalence_TokenOut(uint256[2][] calldata tokenOut) public {
        vm.assume(tokenOut.length > 0 && tokenOut.length <= 10);

        // Ensure valid addresses
        for (uint256 i = 0; i < tokenOut.length; i++) {
            vm.assume(uint160(tokenOut[i][0]) != 0);
            vm.assume(tokenOut[i][1] > 0);
        }

        bytes32 originalHash = original.hashTokenOut(tokenOut);
        bytes32 optimizedHash = optimized.hashTokenOut(tokenOut);

        assertEq(originalHash, optimizedHash, "Fuzz: TokenOut hash mismatch");
    }

    function testFuzzHashEquivalence_Compact(address sponsor, address recipient, uint256 nonce, bytes32[] calldata allElements) public {
        vm.assume(sponsor != address(0));
        vm.assume(recipient != address(0));
        vm.assume(allElements.length > 0 && allElements.length <= 5);

        // Ensure all elements are non-zero
        for (uint256 i = 0; i < allElements.length; i++) {
            vm.assume(allElements[i] != bytes32(0));
        }

        Types.Order memory order = Types.Order({
            sponsor: sponsor,
            recipient: recipient,
            nonce: nonce,
            expires: block.timestamp + 1000,
            fillDeadline: block.timestamp + 500,
            notarizedChainId: 1,
            targetChainId: 1,
            tokenIn: new uint256[2][](0),
            tokenOut: new uint256[2][](0),
            preClaimOps: Types.Operation({ data: "" }),
            targetOps: Types.Operation({ data: "" }),
            qualifier: ""
        });

        bytes32 originalHash = original.hashCompact(order, allElements);
        bytes32 optimizedHash = optimized.hashCompact(order, allElements);

        assertEq(originalHash, optimizedHash, "Fuzz: Compact hash mismatch");
    }

    function testFuzzHashEquivalence_TargetAttributes(
        address recipient,
        uint256 targetChainId,
        uint256 fillDeadline,
        uint256[2][] calldata tokenOut
    )
        public
    {
        vm.assume(recipient != address(0));
        vm.assume(targetChainId > 0 && targetChainId <= 1000);
        vm.assume(fillDeadline > block.timestamp);
        vm.assume(tokenOut.length <= 20);

        // Ensure valid tokenOut addresses
        for (uint256 i = 0; i < tokenOut.length; i++) {
            vm.assume(uint160(tokenOut[i][0]) != 0);
            vm.assume(tokenOut[i][1] > 0);
        }

        Types.Order memory order = Types.Order({
            sponsor: address(0x1),
            recipient: recipient,
            nonce: 1,
            expires: block.timestamp + 1000,
            fillDeadline: fillDeadline,
            notarizedChainId: 1,
            targetChainId: targetChainId,
            tokenIn: new uint256[2][](0),
            tokenOut: tokenOut,
            preClaimOps: Types.Operation({ data: "" }),
            targetOps: Types.Operation({ data: "" }),
            qualifier: ""
        });

        bytes32 originalHash = original.hashTargetAttributes(order);
        bytes32 optimizedHash = optimized.hashTargetAttributes(order);

        assertEq(originalHash, optimizedHash, "Fuzz: TargetAttributes hash mismatch");
    }

    function testFuzzHashEquivalence_Element(address arbiter, uint256 originChainId) public {
        vm.assume(arbiter != address(0));
        vm.assume(originChainId > 0);

        // Create simple test data
        uint256[2][] memory tokenIn = new uint256[2][](1);
        uint256[2][] memory tokenOut = new uint256[2][](1);
        tokenIn[0] = [uint256(uint160(address(0x123))) | (uint256(0x456) << 160), 1000];
        tokenOut[0] = [uint256(uint160(address(0x789))), 2000];

        Types.Order memory order = Types.Order({
            sponsor: address(0x1),
            recipient: address(0x2),
            nonce: 1,
            expires: block.timestamp + 1000,
            fillDeadline: block.timestamp + 500,
            notarizedChainId: 1,
            targetChainId: 1,
            tokenIn: tokenIn,
            tokenOut: tokenOut,
            preClaimOps: Types.Operation({ data: "" }),
            targetOps: Types.Operation({ data: "" }),
            qualifier: ""
        });

        bytes32 originalHash = original.hashElement(order, arbiter, originChainId);
        bytes32 optimizedHash = optimized.hashElement(order, arbiter, originChainId);

        assertEq(originalHash, optimizedHash, "Fuzz: Element hash mismatch");
    }

    function testFuzzHashEquivalence_EdgeCases(uint256 seed) public {
        seed = bound(seed, 1, type(uint128).max);

        // Test various edge cases using seed for deterministic randomness
        uint256 arraySize = (seed % 5) + 1; // 1-5 elements

        uint256[2][] memory tokenIn = new uint256[2][](arraySize);
        uint256[2][] memory tokenOut = new uint256[2][](arraySize);

        for (uint256 i = 0; i < arraySize; i++) {
            // Use seed to generate deterministic but varied test data
            uint256 baseSeed = seed + i * 1000;

            // TokenIn with lockTag
            tokenIn[i] = [
                uint256(uint160(address(uint160((baseSeed % 1_000_000) + 1)))) | ((baseSeed + 1) << 160), // lockTag
                (baseSeed % 1_000_000) + 1 // amount
            ];

            // TokenOut without lockTag
            tokenOut[i] = [uint256(uint160(address(uint160(((baseSeed + 2) % 1_000_000) + 1)))), ((baseSeed + 3) % 1_000_000) + 1];
        }

        bytes32 originalTokenInHash = original.hashTokenIn(tokenIn);
        bytes32 optimizedTokenInHash = optimized.hashTokenIn(tokenIn);
        assertEq(originalTokenInHash, optimizedTokenInHash, "Edge case: TokenIn hash mismatch");

        bytes32 originalTokenOutHash = original.hashTokenOut(tokenOut);
        bytes32 optimizedTokenOutHash = optimized.hashTokenOut(tokenOut);
        assertEq(originalTokenOutHash, optimizedTokenOutHash, "Edge case: TokenOut hash mismatch");
    }

    function testEmptyArrays() public {
        uint256[2][] memory emptyTokenIn = new uint256[2][](0);
        uint256[2][] memory emptyTokenOut = new uint256[2][](0);
        bytes32[] memory emptyElements = new bytes32[](0);

        // Test empty arrays produce same hashes
        bytes32 originalTokenInHash = original.hashTokenIn(emptyTokenIn);
        bytes32 optimizedTokenInHash = optimized.hashTokenIn(emptyTokenIn);
        assertEq(originalTokenInHash, optimizedTokenInHash, "Empty tokenIn hash mismatch");

        bytes32 originalTokenOutHash = original.hashTokenOut(emptyTokenOut);
        bytes32 optimizedTokenOutHash = optimized.hashTokenOut(emptyTokenOut);
        assertEq(originalTokenOutHash, optimizedTokenOutHash, "Empty tokenOut hash mismatch");

        Types.Order memory emptyOrder = Types.Order({
            sponsor: address(0x1),
            recipient: address(0x2),
            nonce: 1,
            expires: block.timestamp + 1000,
            fillDeadline: block.timestamp + 500,
            notarizedChainId: 1,
            targetChainId: 1,
            tokenIn: new uint256[2][](0),
            tokenOut: new uint256[2][](0),
            preClaimOps: Types.Operation({ data: "" }),
            targetOps: Types.Operation({ data: "" }),
            qualifier: ""
        });
        bytes32 originalCompactHash = original.hashCompact(emptyOrder, emptyElements);
        bytes32 optimizedCompactHash = optimized.hashCompact(emptyOrder, emptyElements);
        assertEq(originalCompactHash, optimizedCompactHash, "Empty compact hash mismatch");
    }

    function testLogEmptyArrayHashes() public view {
        uint256[2][] memory emptyTokenIn = new uint256[2][](0);
        uint256[2][] memory emptyTokenOut = new uint256[2][](0);

        // Compute what the original implementation returns for empty arrays
        bytes32 originalTokenInHash = original.hashTokenIn(emptyTokenIn);
        bytes32 originalTokenOutHash = original.hashTokenOut(emptyTokenOut);

        console2.log("=== Empty Array Hash Constants ===");
        console2.log("EMPTY_TOKEN_IN_HASH:");
        console2.logBytes32(originalTokenInHash);
        console2.log("EMPTY_TOKEN_OUT_HASH:");
        console2.logBytes32(originalTokenOutHash);

        // Verify these match the existing NO_EXEC constant (should be the same)
        bytes32 expectedEmptyHash = 0xc5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470;
        console2.log("Current NO_EXEC constant:");
        console2.logBytes32(expectedEmptyHash);

        // Both should match since they're both empty array hashes
        assertEq(originalTokenInHash, expectedEmptyHash, "Empty token in hash should match NO_EXEC");
        assertEq(originalTokenOutHash, expectedEmptyHash, "Empty token out hash should match NO_EXEC");
    }

    function testBenchmark_ScalingPerformance() public {
        console2.log("=== Scaling Performance Benchmark ===");

        uint256[] memory sizes = new uint256[](4);
        sizes[0] = 1;
        sizes[1] = 5;
        sizes[2] = 10;
        sizes[3] = 20;

        for (uint256 s = 0; s < sizes.length; s++) {
            uint256 size = sizes[s];
            uint256[2][] memory tokenIn = new uint256[2][](size);

            for (uint256 i = 0; i < size; i++) {
                tokenIn[i] = [uint256(uint160(address(uint160(0x123 + i)))) | (uint256(0x456 + i) << 160), 1000 + i];
            }

            uint256 originalGas = original.measureTokenInGas(tokenIn);
            uint256 optimizedGas = optimized.measureTokenInGas(tokenIn);

            console2.log("Size:", size);
            console2.log("  Original gas:", originalGas);
            console2.log("  Optimized gas:", optimizedGas);
            console2.log("  Savings:", ((originalGas - optimizedGas) * 100) / originalGas, "%");
            console2.log("  Gas per token (original):", originalGas / size);
            console2.log("  Gas per token (optimized):", optimizedGas / size);
            console2.log("---");
        }
    }
}
