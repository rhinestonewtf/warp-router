// SPDX-License-Identifier: MIT
pragma solidity ^0.8.27;

import { Test } from "forge-std/Test.sol";
import { console2 } from "forge-std/console2.sol";
import { Types } from "@rhinestone/compact-utils/src/types/OrderTypes.sol";
import { Execution } from "modulekit/integrations/ERC7579Exec.sol";
import { Hasher } from "../../src/tests/Hasher.sol";
import { HasherOptimized } from "../../src/tests/HasherOptimized.sol";

contract EIP712TypeHashOptimizationTest is Test {
    Hasher original;
    HasherOptimized optimized;

    function setUp() public {
        original = new Hasher();
        optimized = new HasherOptimized();
    }

    function testHashEquivalence_TokenIn_Single() public {
        uint256[2][] memory tokenIn = new uint256[2][](1);
        tokenIn[0] = [uint256(uint160(address(0x123))) | (uint256(0x456) << 160), 1000];

        bytes32 originalHash = original.hashTokenIn(tokenIn);
        bytes32 optimizedHash = optimized.hashTokenIn(tokenIn);

        assertEq(originalHash, optimizedHash, "Single token hash mismatch");
    }

    function testHashEquivalence_TokenIn_Multiple() public {
        uint256[2][] memory tokenIn = new uint256[2][](3);
        tokenIn[0] = [uint256(uint160(address(0x123))) | (uint256(0x456) << 160), 1000];
        tokenIn[1] = [uint256(uint160(address(0x789))) | (uint256(0xabc) << 160), 2000];
        tokenIn[2] = [uint256(uint160(address(0xdef))) | (uint256(0x123) << 160), 3000];

        bytes32 originalHash = original.hashTokenIn(tokenIn);
        bytes32 optimizedHash = optimized.hashTokenIn(tokenIn);

        assertEq(originalHash, optimizedHash, "Multiple token hash mismatch");
    }

    function testHashEquivalence_TokenOut_Single() public {
        uint256[2][] memory tokenOut = new uint256[2][](1);
        tokenOut[0] = [uint256(uint160(address(0x123))), 1000];

        bytes32 originalHash = original.hashTokenOut(tokenOut);
        bytes32 optimizedHash = optimized.hashTokenOut(tokenOut);

        assertEq(originalHash, optimizedHash, "Single token out hash mismatch");
    }

    function testHashEquivalence_TokenOut_Multiple() public {
        uint256[2][] memory tokenOut = new uint256[2][](3);
        tokenOut[0] = [uint256(uint160(address(0x123))), 1000];
        tokenOut[1] = [uint256(uint160(address(0x789))), 2000];
        tokenOut[2] = [uint256(uint160(address(0xdef))), 3000];

        bytes32 originalHash = original.hashTokenOut(tokenOut);
        bytes32 optimizedHash = optimized.hashTokenOut(tokenOut);

        assertEq(originalHash, optimizedHash, "Multiple token out hash mismatch");
    }

    function testHashEquivalence_Compact() public {
        bytes32[] memory allElements = new bytes32[](3);
        allElements[0] = keccak256("element1");
        allElements[1] = keccak256("element2");
        allElements[2] = keccak256("element3");

        bytes32 originalHash = original.hashCompact(
            Types.Order({
                sponsor: address(0x1),
                recipient: address(0x2),
                nonce: 1,
                expires: block.timestamp + 1000,
                fillDeadline: block.timestamp + 500,
                notarizedChainId: 1,
                targetChainId: 1,
                tokenIn: new uint256[2][](0),
                tokenOut: new uint256[2][](0),
                preClaimOps: Types.Operation({ data: "" }),
                targetOps: Types.Operation({ data: "" }),
                qualifier: ""
            }),
            allElements
        );
        bytes32 optimizedHash = optimized.hashCompact(
            Types.Order({
                sponsor: address(0x1),
                recipient: address(0x2),
                nonce: 1,
                expires: block.timestamp + 1000,
                fillDeadline: block.timestamp + 500,
                notarizedChainId: 1,
                targetChainId: 1,
                tokenIn: new uint256[2][](0),
                tokenOut: new uint256[2][](0),
                preClaimOps: Types.Operation({ data: "" }),
                targetOps: Types.Operation({ data: "" }),
                qualifier: ""
            }),
            allElements
        );

        assertEq(originalHash, optimizedHash, "Compact hash mismatch");
    }

    function testHashEquivalence_Qualifier() public {
        bytes memory data1 = "test qualifier data";
        bytes memory data2 = abi.encode("complex", "qualifier", 123, address(0x456));
        bytes memory data3 = "";

        assertEq(original.hashQualifier(data1), optimized.hashQualifier(data1), "Qualifier hash mismatch 1");
        assertEq(original.hashQualifier(data2), optimized.hashQualifier(data2), "Qualifier hash mismatch 2");
        assertEq(original.hashQualifier(data3), optimized.hashQualifier(data3), "Qualifier hash mismatch 3");
    }

    function testHashEquivalence_TargetAttributes() public {
        Types.Order memory order = Types.Order({
            sponsor: address(0x1),
            recipient: address(0x2),
            nonce: 1,
            expires: block.timestamp + 1000,
            fillDeadline: block.timestamp + 500,
            notarizedChainId: 1,
            targetChainId: 1,
            tokenIn: new uint256[2][](0),
            tokenOut: new uint256[2][](0),
            preClaimOps: Types.Operation({ data: "" }),
            targetOps: Types.Operation({ data: "" }),
            qualifier: ""
        });

        bytes32 originalHash = original.hashTargetAttributes(order);
        bytes32 optimizedHash = optimized.hashTargetAttributes(order);

        assertEq(originalHash, optimizedHash, "TargetAttributes hash mismatch");
    }

    function testHashEquivalence_Element() public {
        uint256[2][] memory tokenIn = new uint256[2][](2);
        tokenIn[0] = [uint256(uint160(address(0x123))) | (uint256(0x456) << 160), 1000];
        tokenIn[1] = [uint256(uint160(address(0x789))) | (uint256(0xabc) << 160), 2000];

        uint256[2][] memory tokenOut = new uint256[2][](2);
        tokenOut[0] = [uint256(uint160(address(0x111))), 1500];
        tokenOut[1] = [uint256(uint160(address(0x222))), 2500];

        Types.Order memory order = Types.Order({
            sponsor: address(0x1),
            recipient: address(0x2),
            nonce: 1,
            expires: block.timestamp + 1000,
            fillDeadline: block.timestamp + 500,
            notarizedChainId: 1,
            targetChainId: 1,
            tokenIn: tokenIn,
            tokenOut: tokenOut,
            preClaimOps: Types.Operation({ data: "" }),
            targetOps: Types.Operation({ data: "" }),
            qualifier: ""
        });

        address arbiter = address(0x888);
        uint256 originChainId = 2;
        bytes32 originalHash = original.hashElement(order, arbiter, originChainId);
        bytes32 optimizedHash = optimized.hashElement(order, arbiter, originChainId);

        assertEq(originalHash, optimizedHash, "Element hash mismatch");
    }

    function testHashEquivalence_Mandate() public {
        uint256[2][] memory tokenOut = new uint256[2][](1);
        tokenOut[0] = [uint256(uint160(address(0x111))), 1500];

        Types.Order memory order = Types.Order({
            sponsor: address(0x1),
            recipient: address(0x2),
            nonce: 1,
            expires: block.timestamp + 1000,
            fillDeadline: block.timestamp + 500,
            notarizedChainId: 1,
            targetChainId: 1,
            tokenIn: new uint256[2][](0),
            tokenOut: tokenOut,
            preClaimOps: Types.Operation({ data: "" }),
            targetOps: Types.Operation({ data: "" }),
            qualifier: "test qualifier"
        });

        bytes32 originalHash = original.hashMandate(order);
        bytes32 optimizedHash = optimized.hashMandate(order);

        assertEq(originalHash, optimizedHash, "Mandate hash mismatch");
    }

    function testHashEquivalence_Ops() public {
        Execution[] memory execs = new Execution[](2);
        execs[0] = Execution({
            target: address(0x111),
            value: 100,
            callData: abi.encodeWithSignature("transfer(address,uint256)", address(0x222), 1000)
        });
        execs[1] = Execution({
            target: address(0x333),
            value: 200,
            callData: abi.encodeWithSignature("approve(address,uint256)", address(0x444), 2000)
        });

        bytes32 originalHash = original.hashOps(execs);
        bytes32 optimizedHash = optimized.hashOps(execs);

        assertEq(originalHash, optimizedHash, "Ops hash mismatch");
    }

    function testGasComparison_Ops() public {
        Execution[] memory execs = new Execution[](3);
        execs[0] = Execution({
            target: address(0x111),
            value: 100,
            callData: abi.encodeWithSignature("transfer(address,uint256)", address(0x222), 1000)
        });
        execs[1] = Execution({
            target: address(0x333),
            value: 200,
            callData: abi.encodeWithSignature("approve(address,uint256)", address(0x444), 2000)
        });
        execs[2] = Execution({ target: address(0x555), value: 0, callData: abi.encodeWithSignature("deposit()", "") });

        uint256 originalGas = original.measureOpsGas(execs);
        uint256 optimizedGas = optimized.measureOpsGas(execs);

        console2.log("=== Operations Gas Comparison (3 operations) ===");
        console2.log("Original gas:", originalGas);
        console2.log("Optimized gas:", optimizedGas);
        console2.log("Gas savings:", originalGas - optimizedGas);
        console2.log("Percent savings:", ((originalGas - optimizedGas) * 100) / originalGas, "%");

        assertLt(optimizedGas, originalGas, "Optimized version should use less gas");
    }

