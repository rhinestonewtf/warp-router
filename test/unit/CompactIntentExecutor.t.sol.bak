    function test_executePreClaimOps_arbiterMismatch() public {
        address account = env.smartAccount1.account;
        address realArbiter = address(this); // msg.sender will be this
        address fakeArbiter = address(0x9999);

        Execution[] memory preClaimOps = new Execution[](1);
        preClaimOps[0] = Execution({
            target: address(env.token1), value: 0, callData: abi.encodeCall(IERC20.approve, (address(env.target), 100 ether))
        });

        ICompactIntentExecutor.EIP712CompactStub memory compactStub =
            ICompactIntentExecutor.EIP712CompactStub({ nonce: 100, expires: block.timestamp + 3600, notarizedChainId: block.chainid });

        ICompactIntentExecutor.EIP712ElementStubOrigin memory elementStub = ICompactIntentExecutor.EIP712ElementStubOrigin({
            otherElements: new bytes32[](0),
            minGas: 0,
            elementOffset: 0,
            destOpsHash: keccak256("dest_ops"),
            tokenInHash: keccak256("token_in"),
            targetAttributesHash: keccak256("target_attrs"),
            qHash: keccak256("qualifier")
        });

        // Compute hash with fake arbiter to create a valid signature
        bytes32 preClaimOpsHash = hasher.hashOps(preClaimOps);
        bytes32 mandateHash = EIP712TypeHashLib.hashMandateRaw(
            elementStub.targetAttributesHash,
            0, //v
            elementStub.minGas,
            preClaimOpsHash,
            elementStub.destOpsHash,
            elementStub.qHash
        );

        bytes32 elementHashWithFakeArbiter = EIP712TypeHashLib.hashElementRaw(
            fakeArbiter, // Wrong arbiter in hash!
            block.chainid,
            elementStub.tokenInHash,
            mandateHash
        );

        // Build the complete claim hash with fake arbiter
        bytes32[] memory allElementsArray = new bytes32[](1);
        allElementsArray[0] = elementHashWithFakeArbiter;
        bytes32 allElementsHash = keccak256(abi.encode(allElementsArray));

        bytes32 claimHashWithFakeArbiter = EIP712TypeHashLib.hashCompact(account, compactStub.nonce, compactStub.expires, allElementsHash);

        // Sign the hash that includes the fake arbiter
        bytes memory signature = abi.encodePacked(address(env.smartAccount1.defaultValidator), _signHash(env.eoa, claimHashWithFakeArbiter));
        Types.Operation memory preClaimOpsOperation =
            SmartExecutionLib.encode(SmartExecutionLib.SigMode.EMISSARYEXECUTION_ERC1271, preClaimOps);
        bytes32 actualClaimHash =
            env.intentExecutor.executePreClaimOpsWithCompactStub(account, compactStub, elementStub, preClaimOpsOperation, signature);

        // The actual claim hash will differ because the arbiter in the hash is this contract, not the fake one
        assertTrue(actualClaimHash != claimHashWithFakeArbiter, "Claim hash should differ due to arbiter mismatch");
    }

    function test_executePreClaimOps_elementOffsetOutOfBounds() public {
        address account = env.smartAccount1.account;

        Execution[] memory preClaimOps = new Execution[](1);
        preClaimOps[0] =
            Execution({ target: address(env.token1), value: 0, callData: abi.encodeCall(IERC20.approve, (address(env.target), 50 ether)) });

        ICompactIntentExecutor.EIP712CompactStub memory compactStub =
            ICompactIntentExecutor.EIP712CompactStub({ nonce: 101, expires: block.timestamp + 3600, notarizedChainId: block.chainid });

        // Create element stub with out-of-bounds offset
        bytes32[] memory elements = new bytes32[](2);
        elements[0] = keccak256("element1");
        elements[1] = keccak256("element2");

        ICompactIntentExecutor.EIP712ElementStubOrigin memory elementStub = ICompactIntentExecutor.EIP712ElementStubOrigin({
            otherElements: elements,
            minGas: 0,
            elementOffset: 10, // Out of bounds
            destOpsHash: keccak256("dest"),
            tokenInHash: keccak256("token"),
            targetAttributesHash: keccak256("attrs"),
            qHash: keccak256("q")
        });

        bytes memory signature = abi.encodePacked(address(env.validator), _signHash(env.eoa, keccak256("dummy")));

        Types.Operation memory preClaimOpsOperation = SmartExecutionLib.encode(SmartExecutionLib.SigMode.ERC1271, preClaimOps);

        // Should revert due to array out of bounds
        vm.expectRevert();
        env.intentExecutor.executePreClaimOpsWithCompactStub(account, compactStub, elementStub, preClaimOpsOperation, signature);
    }

    function test_executePreClaimOps_executeTargetOps_crossChainFlow() public {
        address account = env.smartAccount1.account;
        address arbiter = address(this);
        uint256 nonce = 200;
        uint256 expires = block.timestamp + 3600;
        uint256 fillExpires = block.timestamp + 1800;
        uint256 amount = 100 ether;

        uint256 originChainId = chains.originChain1;
        vm.chainId(originChainId); // Simulate being on origin chain

        uint256 snapshotId = vm.snapshot();

        // Define consistent operations
        Execution[] memory preClaimOps = new Execution[](1);
        preClaimOps[0] =
            Execution({ target: address(env.token1), value: 0, callData: abi.encodeCall(IERC20.approve, (address(env.target), amount)) });

        Execution[] memory targetOps = new Execution[](1);
        targetOps[0] =
            Execution({ target: address(env.token1), value: 0, callData: abi.encodeCall(IERC20.transfer, (env.solver.addr, amount)) });

        // Create consistent hashes
        bytes32 tokenInHash = keccak256(abi.encode(address(env.token1), amount));
        bytes32 tokenOutHash = keccak256(abi.encode(address(env.token2), amount));
        bytes32 preClaimOpsHash = hasher.hashOps(preClaimOps);
        bytes32 targetOpsHash = hasher.hashOps(targetOps);
        bytes32 qHash = keccak256("qualifier");

        bytes32 targetAttributesHash = EIP712TypeHashLib.hashTargetAttributesRaw(account, tokenOutHash, chains.targetChain, fillExpires);

        // Keep mandateHash and elementHash for later use in the test
        bytes32 mandateHash = EIP712TypeHashLib.hashMandateRaw(
            targetAttributesHash,
            SmartExecutionLib.toUint8(SmartExecutionLib.SigMode.EMISSARYEXECUTION_ERC1271), //v
            0, // minGas
            preClaimOpsHash,
            targetOpsHash,
            qHash
        );
        bytes32 elementHash = EIP712TypeHashLib.hashElementRaw(arbiter, block.chainid, tokenInHash, mandateHash);

        // STEP 1: Execute preClaim on origin chain
        ICompactIntentExecutor.EIP712CompactStub memory compactStub = ICompactIntentExecutor.EIP712CompactStub({
            nonce: nonce,
            expires: expires,
            notarizedChainId: originChainId // Origin chain
        });

        ICompactIntentExecutor.EIP712ElementStubOrigin memory originStub = ICompactIntentExecutor.EIP712ElementStubOrigin({
            otherElements: new bytes32[](0),
            minGas: 0,
            elementOffset: 0,
            destOpsHash: targetOpsHash,
            tokenInHash: tokenInHash,
            targetAttributesHash: targetAttributesHash,
            qHash: qHash
        });

        // Convert operations to Types.Operation first to match what executor expects
        Types.Operation memory preClaimOpsOperation =
            SmartExecutionLib.encode(SmartExecutionLib.SigMode.EMISSARYEXECUTION_ERC1271, preClaimOps);

        // Calculate expected claim hash using helper function that matches executor logic exactly
        bytes32 expectedClaimHash = testHelper.preClaimClaimHash(account, compactStub, originStub, preClaimOpsOperation);

        // Create signature using the correct hash and format for emissary execution
        bytes32 digest = testHelper.computeDigest(expectedClaimHash, compactStub.notarizedChainId);
        bytes memory preClaimSignature = abi.encodePacked(address(env.validator), _signHash(env.eoa, digest));

        // Execute preClaim
        bytes32 actualPreClaimHash =
            env.intentExecutor.executePreClaimOpsWithCompactStub(account, compactStub, originStub, preClaimOpsOperation, preClaimSignature);

        assertEq(actualPreClaimHash, expectedClaimHash, "PreClaim hash mismatch");

        // Verify the operations executed
        assertEq(env.token1.allowance(account, address(env.target)), amount, "Approval not set");

        vm.revertTo(snapshotId); // Reset state to before preClaim

        // STEP 2: Execute target operations on destination chain
        // Simulate being on destination chain
        vm.chainId(chains.targetChain);

        ICompactIntentExecutor.EIP712CompactStub memory targetCompactStub = ICompactIntentExecutor.EIP712CompactStub({
            nonce: nonce, // Same nonce
            expires: expires, // Same expires
            notarizedChainId: originChainId
        });

        ICompactIntentExecutor.EIP712ElementStubDestination memory destStub = ICompactIntentExecutor.EIP712ElementStubDestination({
            sponsor: account,
            otherElements: new bytes32[](0),
            elementOffset: 0,
            preClaimOpsHash: preClaimOpsHash,
            tokenInHash: tokenInHash,
            tokenOutHash: tokenOutHash,
            fillExpires: fillExpires,
            targetChain: chains.targetChain,
            qHash: qHash
        });

        // Calculate claim hash for target - should match preClaim hash
        Types.Operation memory targetOpsForHash = SmartExecutionLib.encode(SmartExecutionLib.SigMode.EMISSARYEXECUTION_ERC1271, targetOps);

        // Recalculate element hash for target chain with the correct signature mode
        bytes32 targetElementHash = EIP712TypeHashLib.hashElementRaw(
            arbiter,
            originChainId,
            tokenInHash,
            EIP712TypeHashLib.hashMandateRaw(
                targetAttributesHash,
                SmartExecutionLib.toUint8(SmartExecutionLib.SigMode.EMISSARYEXECUTION_ERC1271), // v - match executor's signature mode
                0, // minGas
                preClaimOpsHash,
                targetOpsHash,
                qHash
            )
        );

        bytes32 targetClaimHash = EIP712TypeHashLib.hashCompact(
            account, nonce, expires, this.insertAtAndHash(destStub.otherElements, destStub.elementOffset, targetElementHash)
        );

        assertEq(targetClaimHash, expectedClaimHash, "Cross-chain claim hash mismatch!");

        // Sign for target ops with the same claim hash
        bytes32 targetDigest = testHelper.computeDigest(expectedClaimHash, originChainId);
        bytes memory targetSignature = abi.encodePacked(address(env.validator), _signHash(env.eoa, targetDigest));
        vm.chainId(chains.targetChain);

        Types.Operation memory targetOpsOperation = SmartExecutionLib.encode(SmartExecutionLib.SigMode.EMISSARYEXECUTION_ERC1271, targetOps);

        // Check balances before execution
        uint256 accountBalanceBefore = env.token1.balanceOf(account);

        // Execute target operations
        vm.prank(address(env.router));
        bytes32 actualTargetHash = env.intentExecutor
            .executeTargetOpsWithCompactStub(account, arbiter, targetCompactStub, destStub, targetOpsOperation, targetSignature);

        assertEq(actualTargetHash, expectedClaimHash, "Target execution hash mismatch");
        assertEq(env.token1.balanceOf(account), accountBalanceBefore - amount, "Transfer not executed");
    }

    function test_executePreClaimOps_emptyOperations() public {
        address account = env.smartAccount1.account;

        // Empty operations array
        Execution[] memory preClaimOps = new Execution[](0);

        ICompactIntentExecutor.EIP712CompactStub memory compactStub =
            ICompactIntentExecutor.EIP712CompactStub({ nonce: 300, expires: block.timestamp + 3600, notarizedChainId: block.chainid });

        ICompactIntentExecutor.EIP712ElementStubOrigin memory elementStub = ICompactIntentExecutor.EIP712ElementStubOrigin({
            otherElements: new bytes32[](0),
            minGas: 0,
            elementOffset: 0,
            destOpsHash: keccak256("dest_ops"),
            tokenInHash: keccak256("token_in"),
            targetAttributesHash: keccak256("target_attrs"),
            qHash: keccak256("qualifier")
        });

        // Convert empty operations to Types.Operation first to match what executor expects
        Types.Operation memory preClaimOpsOperation =
            SmartExecutionLib.encode(SmartExecutionLib.SigMode.EMISSARYEXECUTION_ERC1271, preClaimOps);

        // Calculate expected claim hash using helper function that matches executor logic exactly
        bytes32 expectedClaimHash = testHelper.preClaimClaimHash(account, compactStub, elementStub, preClaimOpsOperation);

        // Create signature using the correct hash and format for emissary execution
        bytes32 digest = testHelper.computeDigest(expectedClaimHash, compactStub.notarizedChainId);
        bytes memory signature = abi.encodePacked(address(env.validator), env.emissaryId, _signHash(env.eoa, digest));

        // Should execute successfully even with no operations
        bytes32 actualClaimHash =
            env.intentExecutor.executePreClaimOpsWithCompactStub(account, compactStub, elementStub, preClaimOpsOperation, signature);

        assertEq(actualClaimHash, expectedClaimHash, "Empty ops claim hash mismatch");
    }

    function test_executeTargetOps_emptyOperations() public {
        address account = env.smartAccount1.account;
        address arbiter = address(0x1234);

        // Empty target operations
        Execution[] memory targetOps = new Execution[](0);

        ICompactIntentExecutor.EIP712CompactStub memory compactStub = ICompactIntentExecutor.EIP712CompactStub({
            nonce: 301, expires: block.timestamp + 3600, notarizedChainId: chains.originChain1
        });

        ICompactIntentExecutor.EIP712ElementStubDestination memory elementStub = ICompactIntentExecutor.EIP712ElementStubDestination({
            sponsor: account,
            otherElements: new bytes32[](0),
            elementOffset: 0,
            preClaimOpsHash: keccak256("preclaim_ops"),
            tokenInHash: keccak256("token_in"),
            tokenOutHash: keccak256("token_out"),
            fillExpires: block.timestamp + 1800,
            targetChain: block.chainid,
            qHash: keccak256("qualifier")
        });

        Types.Operation memory targetOpsForHash = SmartExecutionLib.encode(SmartExecutionLib.SigMode.EMISSARYEXECUTION_ERC1271, targetOps);

        bytes32 expectedClaimHash = testHelper.compactClaimHash(account, arbiter, compactStub, elementStub, targetOpsForHash);

        bytes memory signature =
            abi.encodePacked(address(env.validator), _signHash(env.eoa, _hashTypedData(chains.originChain1, expectedClaimHash)));

        vm.chainId(elementStub.targetChain);

        Types.Operation memory targetOpsOperation = SmartExecutionLib.encode(SmartExecutionLib.SigMode.EMISSARYEXECUTION_ERC1271, targetOps);

        // Should execute successfully with empty operations
        vm.prank(address(env.router));
        bytes32 actualClaimHash =
            env.intentExecutor.executeTargetOpsWithCompactStub(account, arbiter, compactStub, elementStub, targetOpsOperation, signature);

        assertEq(actualClaimHash, expectedClaimHash, "Empty target ops claim hash mismatch");
    }
}
