import { CompactEIP712 } from "@rhinestone/compact-utils/src/types/EIP712.sol";

// Test helper for accessing internal functions
contract CompactIntentTestHelper is IntentExecutor {
    Vm private constant vm = Vm(address(uint160(uint256(keccak256("hevm cheat code")))));

    constructor(address router, address compact, address allocator, address addressBook)
        IntentExecutor(router, compact, allocator, addressBook)
    { }

    function compactClaimHash(
        address account,
        address notarizedArbiter,
        ICompactIntentExecutor.EIP712CompactStub calldata compactStub,
        ICompactIntentExecutor.EIP712ElementStubDestination calldata elementStub,
        Types.Operation calldata targetOps
    )
        external
        returns (bytes32)
    {
        (SmartExecutionLib.SigMode sigMode, Execution[] calldata targetExec) = SmartExecutionLib.decode(targetOps);
        return _compactClaimHash(account, notarizedArbiter, compactStub, elementStub, targetOps, sigMode);
    }

    function preClaimClaimHash(
        address account,
        ICompactIntentExecutor.EIP712CompactStub calldata compactStub,
        ICompactIntentExecutor.EIP712ElementStubOrigin calldata elementStub,
        Types.Operation calldata preClaimOps
    )
        external
        returns (bytes32)
    {
        (SmartExecutionLib.SigMode sigMode, Execution[] calldata preClaimExec) = SmartExecutionLib.decode(preClaimOps);

        bytes32 preClaimOpsHash = EIP712TypeHashLib.hashOperations(preClaimExec);

        bytes32 mandateHash = EIP712TypeHashLib.hashMandateRaw({
            targetAttributes: elementStub.targetAttributesHash,
            minGas: elementStub.minGas,
            preClaimOpsHash: preClaimOpsHash,
            destOpsHash: elementStub.destOpsHash,
            qHash: elementStub.qHash
        });

        // Reconstruct the element hash with the caller as the arbiter
        bytes32 elementHash = EIP712TypeHashLib.hashElementRaw({
            arbiter: msg.sender, originChainId: block.chainid, tokenInHash: elementStub.tokenInHash, mandateHash: mandateHash
        });

        bytes32 allElementsHash = Bytes32ArrayLib.insertAtAndHash(elementStub.otherElements, elementStub.elementOffset, elementHash);

        bytes32 compactHash = EIP712TypeHashLib.hashCompact({
            sponsor: account, nonce: compactStub.nonce, expires: compactStub.expires, allElementsHash: allElementsHash
        });

        return compactHash;
    }

    function computeDigest(bytes32 claimHash, uint256 notarizedChainId) external view returns (bytes32) {
        return _compactHashTypedData(claimHash, notarizedChainId);
    }
}

contract CompactIntentExecutorTest is CompactEnvironment {
    using Bytes32ArrayLib for bytes32[];

    CompactIntentTestHelper testHelper;

    function setUp() public {
        _deployCompact();
        _deploySmartAccount({ create: true });
        _setEmissary(env.smartAccount1, env.eoa);
        _setEmissary(env.smartAccount2, env.orchestrator);

        // Deploy test helper
        testHelper = new CompactIntentTestHelper(address(env.router), address(env.compact), address(env.allocator), address(ADDRESSBOOK));

        // Fund accounts with tokens
        env.token1.mint(env.smartAccount1.account, 1000 ether);
        env.token2.mint(env.smartAccount1.account, 1000 ether);
        env.token3.mint(env.smartAccount1.account, 1000 ether);

        env.token1.mint(env.smartAccount2.account, 1000 ether);
        env.token2.mint(env.smartAccount2.account, 1000 ether);
        env.token3.mint(env.smartAccount2.account, 1000 ether);
    }

    function test_executePreClaimOpsWithCompactStub_success() public {
        address account = env.smartAccount1.account;
        uint256 amount = 100 ether;

        // Prepare pre-claim operations
        Execution[] memory preClaimOps = new Execution[](1);
        preClaimOps[0] =
            Execution({ target: address(env.token1), value: 0, callData: abi.encodeCall(IERC20.approve, (address(env.target), amount)) });

        // Prepare compact stub
        ICompactIntentExecutor.EIP712CompactStub memory compactStub =
            ICompactIntentExecutor.EIP712CompactStub({ nonce: 1, expires: block.timestamp + 3600, notarizedChainId: block.chainid });

        // Prepare element stub for origin chain
        bytes32 tokenInHash = keccak256(abi.encode(address(env.token1), amount));
        bytes32 destOpsHash = keccak256("dest_ops");
        bytes32 targetAttributesHash = keccak256("target_attributes");
        bytes32 qHash = keccak256("qualifier");

        ICompactIntentExecutor.EIP712ElementStubOrigin memory elementStub = ICompactIntentExecutor.EIP712ElementStubOrigin({
            otherElements: new bytes32[](0),
            minGas: 0,
            elementOffset: 0,
            destOpsHash: destOpsHash,
            tokenInHash: tokenInHash,
            targetAttributesHash: targetAttributesHash,
            qHash: qHash
        });

        // Create the operation data as it will be passed to the executor
        // The executor will receive preClaimOps encoded with signature mode
        Types.Operation memory encodedOps = SmartExecutionLib.encode(SmartExecutionLib.SigMode.EMISSARY_EXECUTION, preClaimOps);

        // Create a proper Order struct using the Hasher utility
        uint256[2][] memory tokenIn = new uint256[2][](1);
        tokenIn[0] = [uint256(uint160(address(env.token1))), amount];

        uint256[2][] memory tokenOut = new uint256[2][](0); // Empty for now
        Types.Operation memory emptyOps = Types.Operation({ data: "" });

        // Create a complete order for hashing purposes
        Types.Order memory order = Types.Order({
            sponsor: account,
            recipient: account,
            nonce: compactStub.nonce,
            expires: compactStub.expires,
            fillDeadline: compactStub.expires,
            notarizedChainId: compactStub.notarizedChainId,
            targetChainId: compactStub.notarizedChainId,
            tokenIn: tokenIn,
            tokenOut: tokenOut,
            preClaimOps: emptyOps,
            targetOps: emptyOps,
            qualifier: abi.encode(qHash),
            packedGasValues: uint256(elementStub.minGas) // pack: preClaimGasStipend: 0 (upper 128 bits), minGas: elementStub.minGas (lower
                // 128 bits)
        });

        // Calculate expected claim hash using helper function that matches executor logic exactly
        bytes32 expectedClaimHash = testHelper.preClaimClaimHash(account, compactStub, elementStub, encodedOps);

        // Create signature using the correct hash - must match what executor will compute
        // The executor calls _compactHashTypedData(claimHash, compactStub.notarizedChainId)
        // Let's use the test helper to compute the digest exactly like the executor
        bytes32 digest = testHelper.computeDigest(expectedClaimHash, compactStub.notarizedChainId);
        bytes memory signature = abi.encodePacked(address(env.validator), env.emissaryId, _signHash(env.eoa, digest));

        // Record state before execution
        uint256 allowanceBefore = env.token1.allowance(account, address(env.target));

        // Execute pre-claim operations with the encoded operations
        bytes32 actualClaimHash =
            env.intentExecutor.executePreClaimOpsWithCompactStub(account, compactStub, elementStub, encodedOps, signature);

        // Verify execution
        assertEq(actualClaimHash, expectedClaimHash, "Claim hash mismatch");
        assertEq(env.token1.allowance(account, address(env.target)), allowanceBefore + amount, "Approval not executed");
    }

    function test_executeTargetOpsWithCompactStub_success() public {
        address account = env.smartAccount1.account;
        address arbiter = address(0x1234);
        uint256 amount = 50 ether;

        // Prepare target operations
        Execution[] memory targetOps = new Execution[](1);
        targetOps[0] =
            Execution({ target: address(env.token1), value: 0, callData: abi.encodeCall(IERC20.transfer, (env.solver.addr, amount)) });

        // Prepare compact stub
        ICompactIntentExecutor.EIP712CompactStub memory compactStub =
            ICompactIntentExecutor.EIP712CompactStub({ nonce: 2, expires: block.timestamp + 3600, notarizedChainId: chains.originChain1 });

        // Prepare element stub for destination chain
        bytes32 sponsor = bytes32(uint256(uint160(account)));
        bytes32 tokenInHash = keccak256(abi.encode(address(env.token1), amount));
        bytes32 tokenOutHash = keccak256(abi.encode(address(env.token2), amount));
        bytes32 preClaimOpsHash = keccak256("preclaim_ops");
        bytes32 qHash = keccak256("qualifier");

        ICompactIntentExecutor.EIP712ElementStubDestination memory elementStub = ICompactIntentExecutor.EIP712ElementStubDestination({
            sponsor: account,
            otherElements: new bytes32[](0),
            elementOffset: 0,
            preClaimOpsHash: preClaimOpsHash,
            tokenInHash: tokenInHash,
            tokenOutHash: tokenOutHash,
            fillExpires: block.timestamp + 1800,
            targetChain: block.chainid,
            qHash: qHash
        });

        // Convert Execution[] to Types.Operation for hash calculation
        Types.Operation memory targetOpsForHash = SmartExecutionLib.encode(SmartExecutionLib.SigMode.EMISSARYEXECUTION_ERC1271, targetOps);

        // Calculate expected claim hash
        bytes32 expectedClaimHash = testHelper.compactClaimHash(account, arbiter, compactStub, elementStub, targetOpsForHash);

        // Create signature
        bytes memory signature =
            abi.encodePacked(address(env.validator), _signHash(env.eoa, _hashTypedData(chains.originChain1, expectedClaimHash)));

        // Prank to target chain
        vm.chainId(elementStub.targetChain);

        // Record balances before execution
        uint256 accountBalanceBefore = env.token1.balanceOf(account);
        uint256 solverBalanceBefore = env.token1.balanceOf(env.solver.addr);

        // Convert Execution[] to Types.Operation
        Types.Operation memory targetOpsOperation = SmartExecutionLib.encode(SmartExecutionLib.SigMode.EMISSARYEXECUTION_ERC1271, targetOps);

        // Execute target operations
        vm.prank(address(env.router));
        bytes32 actualClaimHash =
            env.intentExecutor.executeTargetOpsWithCompactStub(account, arbiter, compactStub, elementStub, targetOpsOperation, signature);

        // Verify execution
        assertEq(actualClaimHash, expectedClaimHash, "Claim hash mismatch");
        assertEq(env.token1.balanceOf(account), accountBalanceBefore - amount, "Account balance incorrect");
        assertEq(env.token1.balanceOf(env.solver.addr), solverBalanceBefore + amount, "Solver balance incorrect");
    }

    function test_executeTargetOpsWithCompactStub_revertInvalidChain() public {
        address account = env.smartAccount1.account;
        address arbiter = address(0x1234);

        Execution[] memory targetOps = new Execution[](1);
        targetOps[0] =
            Execution({ target: address(env.token1), value: 0, callData: abi.encodeCall(IERC20.transfer, (env.solver.addr, 100 ether)) });

        ICompactIntentExecutor.EIP712CompactStub memory compactStub =
            ICompactIntentExecutor.EIP712CompactStub({ nonce: 3, expires: block.timestamp + 3600, notarizedChainId: chains.originChain1 });

        ICompactIntentExecutor.EIP712ElementStubDestination memory elementStub = ICompactIntentExecutor.EIP712ElementStubDestination({
            sponsor: account,
            otherElements: new bytes32[](0),
            elementOffset: 0,
            preClaimOpsHash: keccak256("preclaim"),
            tokenInHash: keccak256("token_in"),
            tokenOutHash: keccak256("token_out"),
            fillExpires: block.timestamp + 1800,
            targetChain: 999_999, // Wrong chain ID
            qHash: keccak256("qualifier")
        });

        bytes memory signature = abi.encodePacked(address(env.validator), _signHash(env.eoa, keccak256("dummy")));

        // Convert Execution[] to Types.Operation
        Types.Operation memory targetOpsOperation = SmartExecutionLib.encode(SmartExecutionLib.SigMode.EMISSARYEXECUTION_ERC1271, targetOps);

        // Should revert with InvalidParams error
        vm.prank(address(env.router));
        vm.expectRevert(ICompactIntentExecutor.InvalidParams.selector);
        env.intentExecutor.executeTargetOpsWithCompactStub(account, arbiter, compactStub, elementStub, targetOpsOperation, signature);
    }

